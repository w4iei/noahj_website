{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% if site.title == 'blank' or site.title == blank %}
  {% assign site_title = author_name %}
{% else %}
  {% assign site_title = site.title %}
{% endif %}

{% assign page_description = page.description | default: page.subtitle | default: site.description | strip_html | strip_newlines %}
{% assign page_keywords = page.keywords | default: site.keywords %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign x_username = site.x_username | default: site.data.socials.x_username %}
{% assign seo_image = page.og_image | default: site.seo.default_social_image | default: site.og_image %}
{% if seo_image == blank and page.profile and page.profile.image %}
  {% assign seo_image = page.profile.image | prepend: '/assets/img/' %}
{% endif %}
{% if seo_image == blank and site.author.image %}
  {% assign seo_image = site.author.image %}
{% endif %}
{% if seo_image != blank %}
  {% assign seo_image = seo_image | absolute_url %}
{% endif %}
{% assign robots_content = page.robots
  | default: site.seo.robots
  | default: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
%}
{% assign googlebot_content = page.googlebot | default: site.seo.googlebot | default: robots_content %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}
{% if page.url == '/404.html' or page.redirect %}
  {% assign robots_content = 'noindex, nofollow' %}
  {% assign googlebot_content = 'noindex, nofollow' %}
{% endif %}

{% assign page_title = site_title %}
{% if page.url == '/blog/index.html' or page.url == '/blog/' %}
  {% assign page_title = page.title | append: ' | ' | append: site_title %}
{% elsif page.title != 'blank' and page.url != '/' %}
  {% if page.title == null or page.title == '' %}
    {% assign page_title = page.date | date: '%Y' | append: ' | ' | append: site_title %}
  {% else %}
    {% assign page_title = page.title | append: ' | ' | append: site_title %}
  {% endif %}
{% endif %}

{% if site.google_site_verification or site.bing_site_verification %}
  <!-- Website verification -->
  {% if site.google_site_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if site.bing_site_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ page_title }}</title>
<meta name="author" content="{{ site.author.name | default: author_name }}">
<meta name="description" content="{{ page_description }}">
{% if page_keywords %}
  <meta name="keywords" content="{{ page_keywords }}">
{% endif %}
<meta name="robots" content="{{ robots_content }}">
<meta name="googlebot" content="{{ googlebot_content }}">
<meta name="creator" content="{{ site.author.name | default: author_name }}">
<meta name="publisher" content="{{ site.author.name | default: author_name }}">
{% if seo_image %}
  <meta name="image" content="{{ seo_image }}">
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ site_title }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ page_description }}">
  {% if seo_image %}
    <meta property="og:image" content="{{ seo_image }}">
    <meta property="og:image:alt" content="{{ page_title }}">
  {% endif %}
  <meta property="og:locale" content="{{ site.locale | default: site.lang }}">
  {% if is_blog_post %}
    <meta property="article:author" content="{{ site.author.name | default: author_name }}">
    <meta property="article:published_time" content="{{ page.date | date_to_xmlschema }}">
    <meta
      property="article:modified_time"
      content="{{ page.last_modified_at | default: page.last_updated | default: page.date | date_to_xmlschema }}"
    >
  {% endif %}

  <!-- Twitter card -->
  <meta name="twitter:card" content="{% if seo_image %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ page_description }}">
  {% if seo_image %}
    <meta name="twitter:image" content="{{ seo_image }}">
    <meta name="twitter:image:alt" content="{{ page_title }}">
  {% endif %}
  {% if x_username %}
    <meta name="twitter:site" content="@{{ x_username }}">
    <meta name="twitter:creator" content="@{{ x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  {%
    include schema.liquid
    page_title=page_title
    page_description=page_description
    canonical_url=canonical_url
    author_name=author_name
    seo_image=seo_image
    is_blog_post=is_blog_post
    site_title=site_title
  %}
{% endif %}
